<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- ==================== CONNECTION STRINGS DE PRODUCCIÓN ==================== -->
		<add name="conexionTSD"
			 connectionString="Server=172.16.10.20;Database=TSD;User Id=tecni;Password=Awt2054x-#;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionTSD22"
			 connectionString="Server=172.16.10.22;Database=TSD;User Id=tecni;Password=Awt2054x-#;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionENCUESTA"
			 connectionString="Server=10.0.0.4;Database=ENCUESTA;User Id=tecni;Password=TecX1988%*Abu;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionWebBuzones"
			 connectionString="Server=10.0.0.4;Database=WEBBUZONES;User Id=tecni;Password=TecX1988%*Abu;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		
		<!-- ==================== CONNECTION STRINGS DE TEST (OBLIGATORIAS si RuntimeMode=TEST) ==================== -->
		<!-- ⚠️ IMPORTANTE: En modo TEST, estas connection strings son OBLIGATORIAS. La app fallará al iniciar si faltan. -->
		<!-- ⚠️ Estas deben apuntar a bases de datos de TEST (réplicas), NO a las de PRODUCCIÓN -->
		<add name="conexionTSDTest"
			 connectionString="Server=172.16.10.20;Database=TSD;User Id=tecni;Password=Awt2054x-#;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionTSD22Test"
			 connectionString="Server=172.16.10.22;Database=TSD;User Id=tecni;Password=Awt2054x-#;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionENCUESTATest"
			 connectionString="Server=10.0.0.4;Database=ENCUESTA;User Id=tecni;Password=TecX1988%*Abu;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
		<add name="conexionWebBuzonesTest"
			 connectionString="Server=10.0.0.4;Database=WEBBUZONES;User Id=tecni;Password=TecX1988%*Abu;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- ✅ CONFIGURACIÓN DE RUTAS - Fácil de cambiar sin recompilar -->
	<appSettings>
		<!-- ==================== RUNTIME MODE ==================== -->
		<!-- Modo de ejecución: TEST o PRODUCTION -->
		<!-- Prioridad: 1) ans.mode (archivo), 2) App.config RuntimeMode, 3) Default TEST -->
		<!--<add key="RuntimeMode" value="TEST" />-->
		<add key="RuntimeMode" value="TEST" />  <!-- Descomentar para PRODUCTION -->
		
		<!-- ==================== CONFIGURACIÓN TEST (solo aplica si RuntimeMode=TEST) ==================== -->
		<!-- Carpeta base para archivos en modo TEST (default si no se especifica) -->
		<add key="TestBasePath" value="C:\Users\dchiquiar.ABUDIL\Desktop\TAAS TEST" />
		
		<!-- SMTP en TEST (opcional): false = bloqueado (default seguro), true = permitido con whitelist -->
		<add key="TestAllowSmtp" value="true" />
		<!-- Lista de emails permitidos en TEST (CSV, default: acreditaciones@tecnisegur.com.uy) -->
		<add key="TestEmailWhitelist" value="acreditaciones@tecnisegur.com.uy" />
		
		<!-- ==================== RUTAS BASE ==================== -->
		<!-- ⚠️ IMPORTANTE: Estas rutas son de PRODUCCIÓN. En modo TEST se ignoran y se resuelven automáticamente bajo TestBasePath -->
		<!-- En TEST: las rutas se resuelven automáticamente usando PathResolver bajo TestBasePath -->
		<!-- Ejemplo TEST: RutaBaseLogs PROD = "D:\TECNISEGUR\TAAS FILES\Logs\" → TEST = "C:\Users\dchiquiar.ABUDIL\Desktop\TAAS TEST\Logs\" -->
		
		<!-- Ruta base para logs (PRODUCCIÓN) -->
		<add key="RutaBaseLogs" value="D:\TECNISEGUR\TAAS FILES\Logs\" />
		<!-- <add key="RutaBaseLogs" value="\\servidor\logs\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Logs\ -->
		
		<!-- Ruta base para archivos Excel generados (PRODUCCIÓN) -->
		<add key="RutaBaseExcel" value="D:\TECNISEGUR\TAAS FILES\EXCEL\" />
		<!-- <add key="RutaBaseExcel" value="\\servidor\excel\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Excel\ -->
		
		<!-- ==================== RUTAS SANTANDER ==================== -->
		<!-- ⚠️ IMPORTANTE: Estas rutas son de PRODUCCIÓN. En modo TEST se ignoran y se resuelven automáticamente bajo TestBasePath -->
		<!-- En TEST: las rutas se resuelven automáticamente usando PathResolver bajo TestBasePath\Bancos\SANTANDER\ -->
		<!-- Ejemplo TEST: RutaSantanderPuntoAPunto PROD = "D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\puntoapuntocsvtdr$" -->
		<!--              → TEST = "C:\Users\dchiquiar.ABUDIL\Desktop\TAAS TEST\Bancos\SANTANDER\puntoapuntocsvtdr$" -->
		
		<!-- Ruta base para archivos TXT de Santander (PRODUCCIÓN) -->
		<add key="RutaSantanderBaseTxt" value="D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\" />
		<!-- <add key="RutaSantanderBaseTxt" value="\\servidor\txt\santander\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SANTANDER\ -->
		
		<!-- Ruta para Punto a Punto (P2P) - NO se divide por ciudad, solo por divisa (PESOS/DOLARES) (PRODUCCIÓN) -->
		<add key="RutaSantanderPuntoAPunto" value="D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\puntoapuntocsvtdr$" />
		<!-- <add key="RutaSantanderPuntoAPunto" value="\\servidor\txt\santander\puntoapuntocsvtdr$" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SANTANDER\puntoapuntocsvtdr$ -->
		
		<!-- Ruta para CashOffice P2P de Santander (PRODUCCIÓN) -->
		<add key="RutaSantanderCashOfficeP2P" value="D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\cashoffice$\" />
		<!-- <add key="RutaSantanderCashOfficeP2P" value="\\servidor\txt\santander\cashoffice$\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SANTANDER\cashoffice$\ -->
		
		<!-- Ruta para Tanda de Santander (mantiene estructura con ciudad) (PRODUCCIÓN) -->
		<add key="RutaSantanderTanda" value="D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\tanda$" />
		<!-- <add key="RutaSantanderTanda" value="\\servidor\txt\santander\tanda$" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SANTANDER\tanda$ -->
		
		<!-- Ruta para Día a Día de Santander (mantiene estructura con ciudad) (PRODUCCIÓN) -->
		<add key="RutaSantanderDiaADia" value="D:\TECNISEGUR\TAAS FILES\TXT\SANTANDER\dxd$" />
		<!-- <add key="RutaSantanderDiaADia" value="\\servidor\txt\santander\dxd$" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SANTANDER\dxd$ -->
		
		<!-- ==================== RUTAS SCOTIABANK ==================== -->
		<!-- ⚠️ IMPORTANTE: Estas rutas son de PRODUCCIÓN. En modo TEST se ignoran y se resuelven automáticamente bajo TestBasePath -->
		<!-- En TEST: las rutas se resuelven automáticamente usando PathResolver bajo TestBasePath\Bancos\SCOTIABANK\ -->
		
		<!-- Ruta base para archivos TXT de Scotiabank (archivos generados por ANS) (PRODUCCIÓN) -->
		<add key="RutaScotiabankBaseTxt" value="D:\TECNISEGUR\TAAS FILES\TXT\SCOTIABANK\" />
		<!-- <add key="RutaScotiabankBaseTxt" value="\\servidor\txt\scotiabank\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SCOTIABANK\ -->
		
		<!-- Ruta para archivos de Montevideo (Scotiabank) (PRODUCCIÓN) -->
		<add key="RutaScotiabankMontevideo" value="D:\TECNISEGUR\TAAS FILES\TXT\SCOTIABANK\MONTEVIDEO" />
		<!-- <add key="RutaScotiabankMontevideo" value="\\servidor\txt\scotiabank\montevideo" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SCOTIABANK\MONTEVIDEO -->
		
		<!-- Ruta para archivos de Maldonado (Scotiabank) (PRODUCCIÓN) -->
		<add key="RutaScotiabankMaldonado" value="D:\TECNISEGUR\TAAS FILES\TXT\SCOTIABANK\MALDONADO" />
		<!-- <add key="RutaScotiabankMaldonado" value="\\servidor\txt\scotiabank\maldonado" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SCOTIABANK\MALDONADO -->
		
		<!-- Ruta para CashOffice de Scotiabank (PRODUCCIÓN) -->
		<add key="RutaScotiabankCashOffice" value="D:\TECNISEGUR\TAAS FILES\TXT\SCOTIABANK\cashoffice$\" />
		<!-- <add key="RutaScotiabankCashOffice" value="\\servidor\txt\scotiabank\cashoffice$\CashScotiabank\" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SCOTIABANK\cashoffice$\ -->
		
		<!-- Ruta para archivos de combinación de Scotiabank (donde se leen y generan los combinados) (PRODUCCIÓN) -->
		<add key="RutaScotiabankCombinacion" value="D:\TECNISEGUR\TAAS FILES\TXT\SCOTIABANK\COMBINATION FILES TEST" />
		<!-- <add key="RutaScotiabankCombinacion" value="\\servidor\txt\scotiabank\combination" /> --> <!-- Producción alternativa -->
		<!-- En TEST: se resuelve automáticamente a {TestBasePath}\Bancos\SCOTIABANK\COMBINATION FILES TEST -->
	</appSettings>

</configuration>


